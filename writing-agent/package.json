{
  "name": "@ismail-elkorchi/writing-agent",
  "version": "0.1.0",
  "description": "Writing, editing, and review in a persistent workspace session.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "writing-agent": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui/index.js"
    },
    "./rpc": "./dist/rpc/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.8.0"
  },
  "dependencies": {
    "@agent-core/persistence": "0.2.0",
    "@agent-core/model": "0.2.0",
    "@agent-core/provider-ollama": "0.2.0",
    "@agent-core/provider-openai": "0.2.0",
    "@agent-core/provider-openai-codex": "0.2.0",
    "@agent-core/provider-openrouter": "0.2.0",
    "@agent-core/runtime": "0.2.0",
    "@agent-core/tools": "0.2.0",
    "@agent-core/tools-local": "0.2.0",
    "zod": "4.4.3",
    "@ismail-elkorchi/terminal-ui": "github:Ismail-elkorchi/terminal-ui#e9ec556d96814a8029936106e5a1a6ef70b5da3c",
    "@agent-core/rpc": "0.2.0",
    "@agent-core/tui": "0.2.0"
  }
}
